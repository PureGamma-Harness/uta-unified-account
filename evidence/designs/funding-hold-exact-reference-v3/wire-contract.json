{
  "$defs": {
    "ActionID": {
      "pattern": "^funding-action:v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "ActionIdentity": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "$ref": "#/$defs/ActionID"
        },
        "activation_permission": {
          "const": false
        },
        "payload": {
          "$ref": "#/$defs/ActionPayload"
        }
      },
      "required": [
        "action_id",
        "payload",
        "activation_permission"
      ],
      "type": "object"
    },
    "ActionKey": {
      "additionalProperties": false,
      "properties": {
        "allocation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "scope",
        "allocation_id"
      ],
      "type": "object"
    },
    "ActionPayload": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "action": {
          "const": "CANCEL_QUERY"
        },
        "allocation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "authority_generation": {
          "$ref": "#/$defs/Identifier"
        },
        "authority_id": {
          "$ref": "#/$defs/Identifier"
        },
        "settlement_asset": {
          "const": "USD"
        },
        "terminal_goal": {
          "const": "CONFIRMED_CLOSED"
        }
      },
      "required": [
        "authority_id",
        "authority_generation",
        "account_id",
        "settlement_asset",
        "allocation_id",
        "action",
        "terminal_goal"
      ],
      "type": "object"
    },
    "AggregateUnits": {
      "maximum": 99999999999999999999999999999999999999000,
      "minimum": 0,
      "type": "integer"
    },
    "BaseValues": {
      "additionalProperties": false,
      "properties": {
        "accounting_equity_units": {
          "$ref": "#/$defs/Money"
        },
        "cash_units": {
          "$ref": "#/$defs/Money"
        },
        "funding_components": {
          "const": "EXCLUDED"
        },
        "initial_margin_units": {
          "$ref": "#/$defs/NonnegativeMoney"
        },
        "maintenance_margin_units": {
          "$ref": "#/$defs/NonnegativeMoney"
        },
        "order_reserve_units": {
          "$ref": "#/$defs/NonnegativeMoney"
        },
        "risk_equity_units": {
          "$ref": "#/$defs/Money"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "spot_frozen_units": {
          "$ref": "#/$defs/NonnegativeMoney"
        }
      },
      "required": [
        "scope",
        "accounting_equity_units",
        "risk_equity_units",
        "initial_margin_units",
        "maintenance_margin_units",
        "order_reserve_units",
        "cash_units",
        "spot_frozen_units",
        "funding_components"
