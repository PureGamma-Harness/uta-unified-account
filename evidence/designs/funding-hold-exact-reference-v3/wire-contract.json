    "WaitRecordsValidation": {
      "additionalProperties": false,
      "properties": {
        "action_ids": {
          "items": {
            "$ref": "#/$defs/ActionID"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "activation_permission": {
          "const": false
        },
        "holds_unchanged": {
          "const": true
        },
        "record_count": {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "action_ids",
        "record_count",
        "holds_unchanged",
        "activation_permission"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "D2": "BLOCKED",
  "activation_permission": false,
  "bounds": {
    "derived_inclusive_abs": 400000000000000000000000000000000000000000,
    "financial_leg_exclusive_abs": 100000000000000000000000000000000000000,
    "joint_aggregate_max": 99999999999999999999999999999999999999000,
    "max_duties": 1000,
    "max_wait_records": 1000,
    "request_bytes": 2097152,
    "usd_scale": [
      2,
      8
    ]
  },
  "execution_ready": false,
  "final_lineage_semantics": {
    "DTO_fields_and_nullability": "Unchanged Stage fields; direct/via reachability constraints supplied separately",
    "accounting": "Only active.kind/amount contributes; references/history never retain extraU",
    "all_final_kinds": [
      "FINAL_PAYABLE",
      "FINAL_RECEIVABLE",
      "FINAL_ZERO"
    ],
    "authenticity": "Internal supplied-history consistency only; no authentic content/global history/persistentCAS proof",
    "bridge": "Never repair null/partial/changed lineage or infer refs from currentstate/history; construct/serialize all supplied fields exactly",
    "direct_registered_to_final": "E/C both null and independent typed FINAL_CUT final_ref required",
    "rejections": [
      "missing both viaU refs",
      "partial pair",
      "changed same-duty reference",
      "foreign duty/rulescope",
      "lineage on direct final withoutU",
      "inconsistent replaced provided history"
    ],
    "source": "New local69 forward clarification, independently reviewed54af; no production answer or earlier061 semantic inference",
    "via_U_to_all_finals": "Retain complete exposure_ref and cap_ref exactly equal to immutable previousU; final_ref additionally required"
  },
  "forward_semantic_gap_review": "04dfc2d2bc136b6770913e32c1cd6d4d0f1e7ad4",
  "governing_final_lineage_policy": "69a3e32e9d267295f223671e62f17b2f9e71eb70",
  "governing_policy_commit": "2bb8095faa76ca7d18f957590c7816ba44018554",
  "hashes": {
    "action": "7 exact ActionPayload fields; funding-action:v1: outside hashed JSON",
    "canonical": "sorted keys, separators comma/colon, ensure_ascii true, allow_nan false, ASCII,no BOM/no trailing newline",
    "duty": "9 exact DutyKey fields; funding-duty:v1: outside hashed JSON",
    "policy": "7 exact WaitPolicy fields; bare lowercase SHA256"
  },
  "independent_final_lineage_rule_review": "54af0876ab48b5a5fb50627062f753ac0128c288",
  "independent_rule_review": "86b3c2ac0b41b526cf8ebba2b3babda0b4b97ad1",
  "kind": "INDEPENDENT_FUNDING_D1_SERIALIZED_WIRE_CONTRACT_V3",
  "native_rules": [
    "Exact native JSON str/dict/list/bool/null/int and finite float only; integer excludes bool/int subclasses; finite float never becomes money through conversion",
    "Reject duplicate JSON keys, NaN/Infinity, unknown/missing keys, binary64 money, invalid UTF-8 and oversize requests",
    "Tuple-typed target fields decode from wire arrays by explicit full-field mapping, never by lossy financial conversion",
    "Fixed output-only activation/holds flags in supplied objects must validate before omitted from target constructor init=False arguments",
    "Old expected_active_ref keyword is explicitly UNSUPPORTED; never inferred into a complete Stage",
    "Well-formed unsupported settlement assets are UNSUPPORTED; malformed native types and invalid supported preconditions REJECT",
    "Unexpected target/reference/constructor errors are TECHNICAL_FAILURE outside this response contract, never an expected matching business result",
    "Only exact known HoldError/HoldUnsupported or explicit known wire-decode rejection may be classified by target adapter; do not catch all ValueError/TypeError/Exception as business outcomes",
    "wait_records action_ids must contain every actual returned ID in its actual order; count-only summaries cannot claim full-output equality",
    "Malformed transport/top-level envelope has no valid response correlation and must raise exact WireReject outside the business-classification catch",
    "Transport resource walker counts dict keys and values, aliases by path and rejects cycles; raw and decoded compactASCII byte caps both apply before business classification"
  ],
  "natural_slot_order": [
    "authority_id",
    "authority_generation",
    "symbol",
    "period_end",
    "settlement_asset",
    "account_id"
  ],
  "operations": {
    "action_identity": {
      "input": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/$defs/ActionKey"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "target_call": "ActionKey.action_id; payload copies exact scope/allocation plus contract constants",
      "value": {
        "$ref": "#/$defs/ActionIdentity"
      }
    },
    "aggregate": {
      "input": {
        "additionalProperties": false,
        "properties": {
          "basis_complete": {
            "type": "boolean"
          },
          "scope": {
            "$ref": "#/$defs/Scope"
          },
          "states": {
            "items": {
              "$ref": "#/$defs/DutyState"
            },
            "maxItems": 1000,
            "type": "array"
          }
        },
        "required": [
          "states",
          "scope",
          "basis_complete"
        ],
        "type": "object"
      },
      "target_call": "aggregate(states exact tuple, scope, basis_complete=...)",
      "value": {
        "$ref": "#/$defs/Totals"
      }
    },
    "decompose": {
      "input": {
        "additionalProperties": false,
        "properties": {
          "base": {
            "$ref": "#/$defs/BaseValues"
          },
          "basis_complete": {
            "type": "boolean"
          },
          "states": {
            "items": {
              "$ref": "#/$defs/DutyState"
            },
            "maxItems": 1000,
            "type": "array"
          }
        },
        "required": [
          "base",
          "states",
          "basis_complete"
        ],
        "type": "object"
      },
      "target_call": "target aggregate(states,base.scope,...) then target decompose(base,totals); adapter supplies no financial equations",
      "value": {
        "$ref": "#/$defs/Decomposition"
      }
    },
    "duty_identity": {
      "input": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "$ref": "#/$defs/DutyKey"
          }
        },
        "required": [
          "key"
        ],
        "type": "object"
      },
      "target_call": "DutyKey.payload / .duty_id / .natural_slot; only field/property serialization",
      "value": {
        "$ref": "#/$defs/DutyIdentity"
      }
    },
    "payment_precondition": {
      "input": {
