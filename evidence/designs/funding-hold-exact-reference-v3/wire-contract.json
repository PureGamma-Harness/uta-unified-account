        },
        "expiry_action": {
          "const": "DEFAULT_REVIEW_PRESERVE_DEBT_FREEZE_AND_OUTBOX"
        },
        "format": {
          "const": 1,
          "type": "integer"
        },
        "max_query_attempts": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "max_wait_us": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "min_query_interval_us": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "policy_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "format",
        "policy_id",
        "clock_policy",
        "max_wait_us",
        "min_query_interval_us",
        "max_query_attempts",
        "expiry_action"
      ],
      "type": "object"
    },
    "WaitProjection": {
      "additionalProperties": false,
      "properties": {
        "activation_permission": {
          "const": false
        },
        "holds_unchanged": {
          "const": true
        },
        "outcome": {
          "enum": [
            "WAIT",
            "DEFAULT_REVIEW"
          ]
        },
        "query_counted": {
          "type": "boolean"
        },
        "record": {
          "$ref": "#/$defs/WaitRecord"
