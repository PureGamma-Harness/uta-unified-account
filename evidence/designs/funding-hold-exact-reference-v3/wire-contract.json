      "type": "string"
    },
    "Money": {
      "exclusiveMaximum": 100000000000000000000000000000000000000,
      "exclusiveMinimum": -100000000000000000000000000000000000000,
      "type": "integer"
    },
    "NonnegativeMoney": {
      "exclusiveMaximum": 100000000000000000000000000000000000000,
      "minimum": 0,
      "type": "integer"
    },
    "PaymentProjection": {
      "additionalProperties": false,
      "properties": {
        "activation_permission": {
