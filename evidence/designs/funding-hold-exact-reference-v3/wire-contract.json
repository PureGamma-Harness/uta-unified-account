        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "scope",
        "P",
        "U",
        "N",
        "H",
        "accrual_equity_units",
        "risk_equity_units",
        "available_margin_units",
        "initial_margin_units",
        "maintenance_margin_units",
        "order_reserve_units",
        "ordinary_spend_raw_units",
        "ordinary_spendable_units",
        "activation_permission"
