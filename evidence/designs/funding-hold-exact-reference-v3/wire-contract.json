        },
        "cap_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ContentRef"
            }
          ]
        },
        "exposure_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ContentRef"
            }
          ]
        },
        "final_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ContentRef"
            }
          ]
