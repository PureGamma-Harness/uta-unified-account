        "kind": {
          "enum": [
            "REGISTERED_UNASSESSED",
            "EXPOSURE_RATE_PENDING",
            "FINAL_PAYABLE",
            "FINAL_RECEIVABLE",
            "FINAL_ZERO"
          ]
        }
      },
      "required": [
        "kind",
        "amount_units",
        "exposure_ref",
        "cap_ref",
        "final_ref"
      ],
      "type": "object"
    },
    "Time": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "Totals": {
      "additionalProperties": false,
      "properties": {
        "H": {
          "$ref": "#/$defs/AggregateUnits"
        },
        "N": {
          "$ref": "#/$defs/AggregateUnits"
        },
        "P": {
          "$ref": "#/$defs/AggregateUnits"
        },
        "U": {
          "$ref": "#/$defs/AggregateUnits"
        },
        "activation_permission": {
          "const": false
        },
        "duty_ids": {
          "items": {
            "$ref": "#/$defs/DutyID"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "scope",
        "duty_ids",
        "P",
        "U",
        "N",
        "H",
        "activation_permission"
      ],
