        "payload",
        "activation_permission"
      ],
      "type": "object"
    },
    "SHA256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Scale": {
      "maximum": 8,
      "minimum": 2,
      "type": "integer"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "authority_generation": {
          "$ref": "#/$defs/Identifier"
        },
        "authority_id": {
          "$ref": "#/$defs/Identifier"
        },
        "settlement_asset": {
          "const": "USD"
        },
        "usd_scale": {
          "$ref": "#/$defs/Scale"
        }
