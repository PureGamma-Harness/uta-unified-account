[Unit]
Description=UTA synthetic Cross acceptance authority (not production approved)
Documentation=https://github.com/PureGamma-Harness/uta-unified-account
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=uta
Group=uta
WorkingDirectory=/var/lib/uta
ExecStart=/opt/uta/venv/bin/python -m uta exchange --database /var/lib/uta/exchange.sqlite3 --credentials /etc/uta/credentials.json --asset-scale USD=8 --asset-scale BTC=8 --catalog /etc/uta/products.json --risk-rules /etc/uta/risk-rules.json --automate --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=uta
StateDirectoryMode=0700
ConfigurationDirectory=uta
ConfigurationDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=4096
TasksMax=128

[Install]
WantedBy=multi-user.target
